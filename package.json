{
  "name": "treblewise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Darts scoring, calling and statistics in the browser, with a camera autoscorer.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace @treblewise/web",
    "build": "npm run build --workspace @treblewise/web",
    "preview": "npm run preview --workspace @treblewise/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build --force",
    "eval:find-board": "vite-node packages/core/scripts/eval-find-board.ts --"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
